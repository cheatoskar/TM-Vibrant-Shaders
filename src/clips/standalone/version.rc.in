#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @TMCLIPS_V0@,@TMCLIPS_V1@,@TMCLIPS_V2@,0
PRODUCTVERSION @TMCLIPS_V0@,@TMCLIPS_V1@,@TMCLIPS_V2@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "cheatoskar"
            VALUE "FileDescription", "TM Clips: instant replay clips for TrackMania Forever"
            VALUE "FileVersion", "@TMCLIPS_VERSION@"
            VALUE "InternalName", "TMClips"
            VALUE "LegalCopyright", "(c) 2026 cheatoskar"
            VALUE "OriginalFilename", "TMClips.dll"
            VALUE "ProductName", "TM Clips"
            VALUE "ProductVersion", "@TMCLIPS_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
