    Direct3DCreate9=TMVS_Direct3DCreate9
    Direct3DCreate9Ex=TMVS_Direct3DCreate9Ex
    D3DPERF_BeginEvent=TMVS_D3DPERF_BeginEvent
    D3DPERF_EndEvent=TMVS_D3DPERF_EndEvent
