#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @TMVS_V0@,@TMVS_V1@,@TMVS_V2@,0
PRODUCTVERSION @TMVS_V0@,@TMVS_V1@,@TMVS_V2@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "cheatoskar"
            VALUE "FileDescription", "@TMVS_FILE_DESCRIPTION@"
            VALUE "FileVersion", "@TM_SHADERS_VERSION@"
            VALUE "InternalName", "@TMVS_INTERNAL_NAME@"
            VALUE "LegalCopyright", "(c) 2026 cheatoskar"
            VALUE "OriginalFilename", "@TMVS_ORIGINAL_FILENAME@"
            VALUE "ProductName", "TM Vibrant Shaders"
            VALUE "ProductVersion", "@TM_SHADERS_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
